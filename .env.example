# SERAPH — copy to `.env` and fill in. `.env` is gitignored; never commit it.

# --- Postgres + TimescaleDB (docker-compose.yml) ---
POSTGRES_USER=seraph
# REQUIRED — no default. Generate a unique local value, e.g.:
#   py -3.12 -c "import secrets; print(secrets.token_urlsafe(32))"
# docker-compose.yml fails fast if this is empty. Never commit the filled value.
POSTGRES_PASSWORD=
POSTGRES_DB=seraph
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# --- External data sources (C2, Phase 2 — leave blank until then) ---
# Zerodha Kite Connect (DATA-ACQUISITION §1). Paid tier, intraday bars only.
# Kite-derived data may not be publicly redistributed — keep C12 local/demo-only.
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# FRED (Brent, INR) — free API key from https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
